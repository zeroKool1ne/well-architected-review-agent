# AWS
AWS_REGION=us-east-1

# Bedrock — note the "us." inference-profile prefix; the bare model id is rejected
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Storage
S3_BUCKET=
DYNAMODB_TABLE=
SQS_QUEUE_URL=

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=well-architected-review-agent
LANGSMITH_API_KEY=
# EU-hosted accounts need this; the client defaults to the US region and
# returns 403 Forbidden against it.
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
